# Node 24 required. Deploy with a persistent, backed-up disk (not static S3 alone).
APP_ORIGIN=https://kz.tripsoda.com
KZ_DATA_DIR=/var/lib/tripsoda-kz
# Generate hashes with npm run admin:setup, password via stdin.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=alua@tripsoda.com,jinki@tripsoda.com
